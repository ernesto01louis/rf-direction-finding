# Authelia stack — secrets + tunables.
# Standalone: `cp .env.example .env` and fill every REPLACE value.
# Ansible renders this file automatically from vault/secrets.yml.
#
# Generate 64-hex-char randoms with: openssl rand -hex 32

# --- Core secrets -----------------------------------------------------------
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=REPLACE
AUTHELIA_SESSION_SECRET=REPLACE
AUTHELIA_STORAGE_ENCRYPTION_KEY=REPLACE
AUTHELIA_SESSION_REDIS_PASSWORD=REPLACE

# --- OIDC provider ----------------------------------------------------------
AUTHELIA_IDENTITY_PROVIDERS_OIDC_HMAC_SECRET=REPLACE
# JWKS signing key, loaded from a mounted file. The authelia role writes
# ./secrets/oidc.private.pem from vault; for standalone use, drop an
# RSA-4096 PEM (openssl genrsa 4096) at that path.
AUTHELIA_IDENTITY_PROVIDERS_OIDC_JWKS_0_KEY_FILE=/secrets/oidc.private.pem

# --- SMTP notifier (optional) ----------------------------------------------
# Leave blank to use the filesystem notifier configured in configuration.yml.
# To send real mail: set these and swap notifier.filesystem for notifier.smtp.
AUTHELIA_NOTIFIER_SMTP_ADDRESS=
AUTHELIA_NOTIFIER_SMTP_USERNAME=
AUTHELIA_NOTIFIER_SMTP_PASSWORD=
AUTHELIA_NOTIFIER_SMTP_SENDER=authelia@rf.lan
