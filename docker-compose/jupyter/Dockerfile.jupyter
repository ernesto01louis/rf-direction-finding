# JupyterLab — Jupyter scipy-notebook with the rfdf platform pre-installed.
FROM quay.io/jupyter/scipy-notebook:2024-12-23

ARG RFDF_VERSION=v0.1.0-alpha

# Install base `rfdf`. The scipy-notebook base already carries the scientific
# Python stack; the [ml] extra's torchsig dependency tree backtracks pip for
# hours inside a Docker build, so it is NOT baked in — add it in-container
# when needed: pip install 'rfdf[ml]'.
RUN pip install --no-cache-dir \
        "rfdf @ git+https://github.com/ernesto01louis/rf-direction-finding.git@${RFDF_VERSION}"
