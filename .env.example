# Example environment file. Copy to `.env` and fill in. NEVER commit `.env`.
#
# At Stage 1 no env vars are required to run the platform. This file is a
# placeholder so future stages have a single canonical reference.

# --- Orchestrator integration (Stage 7) ---
# AI_ORCHESTRATOR_BASE_URL=http://192.168.2.218:8000
# AI_ORCHESTRATOR_API_TOKEN=

# --- Compute backends (Stage 4) ---
