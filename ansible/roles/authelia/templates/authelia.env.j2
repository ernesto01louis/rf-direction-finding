# {{ ansible_managed }}
# Authelia secrets — rendered by the authelia role from vault/secrets.yml.
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET={{ authelia_jwt_secret }}
AUTHELIA_SESSION_SECRET={{ authelia_session_secret }}
AUTHELIA_STORAGE_ENCRYPTION_KEY={{ authelia_storage_encryption_key }}
AUTHELIA_SESSION_REDIS_PASSWORD={{ authelia_redis_password }}
#AUTHELIA_IDENTITY_PROVIDERS_OIDC_HMAC_SECRET={{ authelia_oidc_hmac_secret }}
#AUTHELIA_IDENTITY_PROVIDERS_OIDC_JWKS_0_KEY_FILE=/secrets/oidc.private.pem
{% if authelia_smtp_host | default('') %}
AUTHELIA_NOTIFIER_SMTP_ADDRESS=submission://{{ authelia_smtp_host }}:{{ authelia_smtp_port }}
AUTHELIA_NOTIFIER_SMTP_USERNAME={{ authelia_smtp_username }}
AUTHELIA_NOTIFIER_SMTP_PASSWORD={{ authelia_smtp_password }}
AUTHELIA_NOTIFIER_SMTP_SENDER={{ authelia_smtp_sender }}
{% endif %}
